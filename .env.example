# Optional network override. Defaults to testnet.
VITE_DREAMDEX_NETWORK=testnet

# Optional endpoint overrides. Official endpoints are used when blank.
VITE_DREAMDEX_INDEXER_URL=
VITE_DREAMDEX_WS_RPC_URL=

# Server-only Neon Postgres connection string. Use the raw postgresql:// URL,
# without the surrounding psql command. Leave blank for local JSON development.
DATABASE_URL=

# Optional server settings.
PORT=8787
HOST=0.0.0.0
